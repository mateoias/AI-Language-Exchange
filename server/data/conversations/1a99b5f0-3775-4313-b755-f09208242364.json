          "timestamp": "2025-06-24T01:29:39.540680",
          "intent": "normal_chat",
          "audio_language": "Spanish",
          "id": "user-18-1750728579"
        },
        {
          "content": "¡Vaya! Vivir en Taiwán durante 20 años debe haber sido una experiencia interesante. ¿Qué fue lo que más te gustó de vivir allí?",
          "sender": "bot",
          "timestamp": "2025-06-24T01:29:43.411672",
